# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
*.tsbuildinfo
# (exception: docs/build/ hosts build prompts / construction docs, not TS output)
!docs/build/
# Packaged copy of skills/ (generated by scripts/bundle-skills.mjs; npm packs
# it via the package's "files" list — the source of truth stays <repo>/skills/)
packages/cli/skills/

# Projected documentation pages (scripts/site-docs/gen.mjs → site/docs/, issue
# #277). A deploy artifact, never committed: the Markdown is the only copy.
site/docs/

# Local data / secrets (NUNCA commiteados)
.env
.env.*
*.local
brand-data/
data/**/content/*.yml.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Research drafts
docs/research/_drafts/

# Harness artifacts (pi/AionUi session skills)
.pi/

# Session worktrees ({repo}/.worktrees/{branch}/) — one per agent session.
.worktrees/

# In-repo session state — per-session/per-operator, never tracked. Each piece
# has its own home; this line only keeps all of them out of git:
#   sprints/      sprint boards (in-repo by design, #310)
#   outbox/       maintenance-ledger outbox drain
#   worktrees/    worktree index + symlinks (the worktrees themselves are above)
#   maintenance/  the maintenance ledger a sprint declares inside the repo
.agos/

# Session artifacts are never versioned in this public repo (issue #274): the
# evidence of a past session lives in its PR, not in the checkout. The blobs of
# these directories remain in git history; see CONTRIBUTING §What stays out of
# the tree.
.sota/
.e2e/
.e2e-agentic/

# vitest JSON reporter output (generated; contains absolute paths)
.vitest/

# Site-root artifacts projected by scripts/site-docs/gen.mjs (issue #279):
# generated at deploy, never committed — same rule as site/docs/.
site/404.html
site/sitemap.xml
site/robots.txt
site/llms.txt
site/AGENTS.md
