{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profile-as-code.dev/schema/v1/profile.schema.json",
  "title": "profile-as-code — user profile contract (v1)",
  "description": "Contract source (D3) for a user-brand-data workspace. The core `load()` parses content/*.yaml, merges them into a single Profile and validates against THIS schema. Facts (dates, DOIs, URLs, ORCID) are language-independent and are the GEO anchor. Every text field is a langMap ({lang: value}) with EN required (D8, §11).",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity"],
  "properties": {
    "identity": {
      "$ref": "#/$defs/identity",
      "description": "Canonical identity. THE source of truth for URLs and names (GEO anchor)."
    },
    "positioning": {
      "$ref": "#/$defs/positioning",
      "description": "Value proposition: statement, per-audience angles, GEO intent."
    },
    "bios": {
      "type": "array",
      "items": { "$ref": "#/$defs/bio" },
      "description": "Curated bio per platform+lang+length. Generated by `pac refine`, chosen by the user, stored here."
    },
    "headlines": {
      "type": "array",
      "items": { "$ref": "#/$defs/headline" },
      "description": "Headline per platform+lang (the 1-line under the name)."
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    },
    "experience": {
      "type": "array",
      "items": { "$ref": "#/$defs/experienceItem" }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/project" }
    },
    "publications": {
      "type": "array",
      "items": { "$ref": "#/$defs/publication" },
      "description": "Peer-reviewed / citable output. DOI/ORCID resolvable → GEO citability."
    },
    "keywords": {
      "$ref": "#/$defs/keywords",
      "description": "SEO per platform + GEO associations/claims (cross-cutting layer, D7)."
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" },
      "description": "User-level declarative checks; unioned with the platform skill's checks.yaml by `pac check`."
    },
    "active": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/activeEntry" },
      "description": "Which bio/headline variant is LIVE per platform (D11: user picks, engine records)."
    }
  },

  "$defs": {
    "lang": {
      "type": "string",
      "enum": ["en", "es", "fr"],
      "description": "Supported languages. EN required (international recruiters), ES native, FR desirable (D8)."
    },

    "langMap": {
      "type": "object",
      "required": ["en"],
      "propertyNames": { "$ref": "#/$defs/lang" },
      "description": "Text in one or more languages. EN is ALWAYS required — a schema rule enforced by `pac validate` (§11). Key restriction via propertyNames (enum en/es/fr).",
      "minProperties": 1
    },

    "url": {
      "type": "string",
      "format": "uri",
      "minLength": 7
    },

    "date": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD. Facts are language-independent (GEO anchor). Month/year precision allowed (YYYY-MM via YYYY-MM-01)."
    },

    "platform": {
      "type": "string",
      "enum": ["github-readme", "linkedin", "upwork", "x", "researchgate", "substack"],
      "description": "v1 platform set. Substack added in D-scope; web renderer consumes compiled profiles (M5)."
    },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "photo": { "$ref": "#/$defs/url" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "platform": { "type": "string" },
              "label": { "type": "string" },
              "url": { "$ref": "#/$defs/url" }
            }
          },
          "description": "Canonical link set. Renderers and skills read URLs ONLY from here — no per-platform URL duplication (drift source)."
        }
      }
    },

    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": { "$ref": "#/$defs/langMap" },
        "audiences": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" },
          "description": "Audience name → per-lang angle (e.g. recruiter / client / academia)."
        },
        "geo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "semanticAssociations": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 3,
              "maxItems": 5,
              "description": "3-5 anchors an LLM should associate with the person (e.g. 'física', 'innovación educativa', 'soberanía de IA'). Seeded without stuffing (§8)."
            },
            "citationsGoal": { "$ref": "#/$defs/langMap" }
          }
        }
      }
    },

    "bio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "lang", "length", "text"],
      "properties": {
        "platform": { "$ref": "#/$defs/platform" },
        "lang": { "$ref": "#/$defs/lang" },
        "length": { "type": "string", "enum": ["short", "medium", "long"] },
        "text": { "type": "string", "minLength": 1 }
      }
    },

    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "lang", "text"],
      "properties": {
        "platform": { "$ref": "#/$defs/platform" },
        "lang": { "$ref": "#/$defs/lang" },
        "text": { "type": "string", "minLength": 1 }
      }
    },

    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "enum": ["novice", "intermediate", "advanced", "expert"] },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "geoKeywords": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Terms a generative engine should match this skill with (GEO layer, D7)."
        },
        "platformWeights": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": "How much this skill matters per platform (0..1). Feeds renderer keyword placement."
        }
      }
    },

    "experienceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "org", "start"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "org": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/date" },
        "end": { "anyOf": [{ "$ref": "#/$defs/date" }, { "const": "present" }] },
        "highlights": { "$ref": "#/$defs/langMap" }
      },
      "description": "start <= end is NOT expressible in JSON Schema — enforced by core.driftCheck (§12 note)."
    },

    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "maintained", "archived", "experimental", "planning"] },
        "description": { "$ref": "#/$defs/langMap" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/url" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } }
      }
    },

    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "source"],
      "description": "Verifiable claim with source. Anti-pattern: unverifiable claims (dropped by cite-aware systems, §8).",
      "properties": {
        "claim": { "$ref": "#/$defs/langMap" },
        "source": { "$ref": "#/$defs/url" },
        "verified": { "$ref": "#/$defs/date" }
      }
    },

    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "venue", "year"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "venue": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
        "orcidId": { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" }
      },
      "description": "DOI/ORCID must be resolvable — GEO citability anchor (LLMs resolve them)."
    },

    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } },
          "description": "Per-platform SEO keyword sets (fed by each platform skill's research)."
        },
        "geo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "associations": { "type": "array", "items": { "type": "string" } },
            "claims": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "rule", "value"],
      "properties": {
        "id": { "type": "string" },
        "platform": { "type": "string", "enum": ["all", "github-readme", "linkedin", "upwork", "x", "researchgate", "substack"] },
        "rule": {
          "type": "string",
          "enum": [
            "max-chars",
            "min-chars",
            "url-live",
            "fact-present",
            "geo-consistent",
            "lang-present",
            "link-in-identity"
          ],
          "description": "Rule catalog (extensible). Skills' checks.yaml use the same catalog; `pac check` runs the union."
        },
        "value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string" },
            { "type": "boolean" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "note": { "type": "string" }
      }
    },

    "activeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lang", "variantId", "chosenAt"],
      "properties": {
        "lang": { "$ref": "#/$defs/lang" },
        "variantId": { "type": "string", "minLength": 1 },
        "chosenAt": { "type": "string", "format": "date-time" }
      },
      "description": "The chosen variant id — user picked it (D11); variant body lives in the workspace variants store."
    }
  }
}
