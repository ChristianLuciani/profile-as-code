{
  "name": "profile-as-code",
  "version": "0.1.0",
  "private": true,
  "description": "Engine monorepo — schema (the contract), packages/core (validate · drift · geo · compile).",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "gen:zod": "pnpm -F @profile-as-code/core gen:zod",
    "gen:renderers": "node scripts/renderer-map/gen.mjs",
    "gen:platforms": "node scripts/gen-platforms/gen.mjs",
    "gen:doc-links": "node scripts/link-check/check.mjs",
    "gen:packages": "node scripts/gen-packages/gen.mjs",
    "gen:site-docs": "node scripts/site-docs/gen.mjs",
    "site": "node scripts/site-docs/gen.mjs && node scripts/site-check/check.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "marked": "^18.1.1",
    "marked-gfm-heading-id": "^4.1.4",
    "publint": "^0.3.25",
    "yaml": "^2.9.1"
  }
}
