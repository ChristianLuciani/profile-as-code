{
  "name": "profile-as-code",
  "version": "0.1.0",
  "private": true,
  "description": "Engine monorepo — schema (the contract), packages/core (validate · drift · geo · compile).",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "gen:zod": "pnpm -F @profile-as-code/core gen:zod"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  }
}
