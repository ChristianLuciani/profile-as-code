{
  "name": "@profile-as-code/artifact",
  "private": true,
  "version": "0.1.0",
  "description": "The canonical artifact projection of SPEC §19.5 (bound + transport normalization) plus its conformance body. The ONE home of the projection every verifying adapter delegates to — issue #216, D5.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianLuciani/profile-as-code.git",
    "directory": "packages/artifact"
  },
  "bugs": {
    "url": "https://github.com/ChristianLuciani/profile-as-code/issues"
  },
  "homepage": "https://github.com/ChristianLuciani/profile-as-code/tree/main/packages/artifact#readme",
  "sideEffects": false,
  "keywords": [
    "profile-as-code",
    "artifact",
    "projection",
    "extractor",
    "certification",
    "conformance",
    "shared"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
