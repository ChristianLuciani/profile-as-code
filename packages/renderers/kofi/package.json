{
  "name": "@profile-as-code/renderers-kofi",
  "private": true,
  "version": "0.1.0",
  "description": "Renderer kofi (v1.7, issue #130): deterministic plain-text About paste-source from a PlatformProfile slice. Ko-fi is a paste platform (D9) — the artifact IS the text to paste. Pure function of the SSOT — no network, no AI, no randomness.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianLuciani/profile-as-code.git",
    "directory": "packages/renderers/kofi"
  },
  "bugs": {
    "url": "https://github.com/ChristianLuciani/profile-as-code/issues"
  },
  "homepage": "https://github.com/ChristianLuciani/profile-as-code/tree/main/packages/renderers/kofi#readme",
  "sideEffects": false,
  "pasco": {
    "platform": "kofi",
    "deploySpec": "manual"
  },
  "keywords": [
    "profile-as-code",
    "kofi",
    "ko-fi",
    "creator",
    "donations",
    "paste",
    "renderer"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@profile-as-code/core": "workspace:*",
    "@profile-as-code/paste": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
