{
  "name": "@profile-as-code/renderers-github-readme",
  "version": "0.1.0",
  "description": "Renderer github-readme (M2): deterministic, byte-stable README.md from a PlatformProfile (compile() slice). Pure function of the SSOT — no network, no AI, no randomness. SPEC §15.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@profile-as-code/core": "workspace:*",
    "@profile-as-code/markdown": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
