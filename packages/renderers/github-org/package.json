{
  "name": "@profile-as-code/renderers-github-org",
  "private": true,
  "version": "0.1.0",
  "description": "Renderer github-org (M6, brand flavor): deterministic, byte-stable org README.md from a brand PlatformProfile (compile() slice). Pure function of the SSOT — no network, no AI, no randomness. SPEC §17.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianLuciani/profile-as-code.git",
    "directory": "packages/renderers/github-org"
  },
  "bugs": {
    "url": "https://github.com/ChristianLuciani/profile-as-code/issues"
  },
  "homepage": "https://github.com/ChristianLuciani/profile-as-code/tree/main/packages/renderers/github-org#readme",
  "sideEffects": false,
  "pasco": {
    "platform": "github-org",
    "deploySpec": "git"
  },
  "keywords": [
    "profile-as-code",
    "github",
    "organization",
    "readme",
    "brand",
    "renderer",
    "json-ld"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@profile-as-code/artifact": "workspace:*",
    "@profile-as-code/core": "workspace:*",
    "@profile-as-code/github": "workspace:*",
    "@profile-as-code/markdown": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
