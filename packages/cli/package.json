{
  "name": "@profile-as-code/cli",
  "version": "0.1.0",
  "description": "pac — the profile-as-code CLI (M1): init, validate, build, diff + explicit stubs (refine/check/skills:install). Consumes @profile-as-code/core; never re-implements load/drift/geo/compile.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pac": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @profile-as-code/core build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@profile-as-code/core": "workspace:*",
    "@profile-as-code/renderers-github-readme": "workspace:*",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
