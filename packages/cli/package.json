{
  "name": "@profile-as-code/cli",
  "version": "0.3.0",
  "description": "pasco — the profile-as-code CLI: init, validate, build, diff, status + partial refine (task template), check (offline rules M6–M8; catalog ships M3/M4), skills:export (copies the platform skills this package ships). Consumes @profile-as-code/core; never re-implements load/drift/geo/compile.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pasco": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianLuciani/profile-as-code.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ChristianLuciani/profile-as-code/issues"
  },
  "homepage": "https://github.com/ChristianLuciani/profile-as-code/tree/main/packages/cli#readme",
  "keywords": [
    "profile-as-code",
    "pasco",
    "cli",
    "profile",
    "personal-brand",
    "static-site",
    "json-schema"
  ],
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "pnpm --filter \"@profile-as-code/cli^...\" build && tsup && node scripts/bundle-skills.mjs && node -e \"process.platform !== 'win32' && require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "verify:pack": "node scripts/verify-pack.mjs",
    "guard:release": "node scripts/release-guard.mjs",
    "prepublishOnly": "publint",
    "prepack": "node scripts/bundle-skills.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@profile-as-code/artifact": "workspace:*",
    "@profile-as-code/core": "workspace:*",
    "@profile-as-code/github": "workspace:*",
    "@profile-as-code/paste": "workspace:*",
    "@profile-as-code/renderers-buymeacoffee": "workspace:*",
    "@profile-as-code/renderers-github-org": "workspace:*",
    "@profile-as-code/renderers-github-readme": "workspace:*",
    "@profile-as-code/renderers-gumroad": "workspace:*",
    "@profile-as-code/renderers-hotmart": "workspace:*",
    "@profile-as-code/renderers-kofi": "workspace:*",
    "@profile-as-code/renderers-liberapay": "workspace:*",
    "@profile-as-code/renderers-payhip": "workspace:*",
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
